@model RealEstatePlatform.Core.Entities.Property

@{
    ViewData["Title"] = "Yeni İlan Ekle";
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<div class="container mt-5">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">🏠 Yeni Gayrimenkul İlanı Oluştur</h4>
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="All" class="text-danger mb-3 fw-bold"></div>
                
                <div class="row">
                    <div class="col-md-6">
                        <h5 class="text-secondary border-bottom pb-2">Temel Bilgiler</h5>
                        <div class="mb-3">
                            <label class="form-label fw-bold">İlan Başlığı</label>
                            <input asp-for="Title" class="form-control" placeholder="Örn: Kadıköy Merkezde Deniz Manzaralı 3+1" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Açıklama</label>
                            <textarea asp-for="Description" class="form-control" rows="4" required></textarea>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Fiyat (₺)</label>
                                <input asp-for="Price" type="number" class="form-control" required />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Oda Sayısı</label>
                                <input asp-for="RoomCount" class="form-control" placeholder="Örn: 3+1" required />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Metrekare (m²)</label>
                                <input asp-for="SquareMeters" type="number" class="form-control" required />
                            </div>
                            <div class="col-md-6 mb-3 d-flex align-items-end">
                                <div class="form-check form-switch fs-5">
                                    <input asp-for="HasParking" class="form-check-input" type="checkbox" id="parkingSwitch">
                                    <label class="form-check-label" for="parkingSwitch">Otopark Var mı?</label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <h5 class="text-secondary border-bottom pb-2">Konum Bilgileri</h5>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">İl</label>
                                <input asp-for="Location.City" class="form-control" placeholder="Örn: İstanbul" required />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">İlçe</label>
                                <input asp-for="Location.District" class="form-control" placeholder="Örn: Kadıköy" required />
                            </div>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label fw-bold">İlan Fotoğrafları Yükle (Çoklu Seçebilirsiniz)</label>
                            <input type="file" name="imageFiles" class="form-control" multiple accept="image/*" />
                            <small class="text-muted">Görseller C# tarafından otomatik sıkıştırılıp logo eklenecektir.</small>
                        </div>

                        <input type="hidden" asp-for="Location.Latitude" id="Latitude" />
                        <input type="hidden" asp-for="Location.Longitude" id="Longitude" />
                    </div>
                </div>

                <div class="text-end mt-4">
                    <a href="/Property/Index" class="btn btn-secondary me-2">İptal</a>
                    <button type="submit" class="btn btn-success btn-lg">Kaydet ve Yayınla</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    
    <script>
        // 1. Haritayı başlat ve varsayılan olarak Türkiye (İstanbul) merkezli aç
        var map = L.map('map').setView([41.0082, 28.9784], 10);

        // 2. Harita görsellerini (Tile) OpenStreetMap'ten çek
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '© OpenStreetMap contributors'
        }).addTo(map);

        var marker;

        // 3. Kullanıcı haritaya tıkladığında çalışacak fonksiyon
        map.on('click', function (e) {
            var lat = e.latlng.lat;
            var lng = e.latlng.lng;

            // Varsa eski markeri sil
            if (marker) {
                map.removeLayer(marker);
            }

            // Yeni marker (işaretçi) ekle
            marker = L.marker([lat, lng]).addTo(map);

            // Tıklanan yerin koordinatlarını gizli HTML Inputlarına yaz
            document.getElementById('Latitude').value = lat;
            document.getElementById('Longitude').value = lng;
        });
    </script>
}