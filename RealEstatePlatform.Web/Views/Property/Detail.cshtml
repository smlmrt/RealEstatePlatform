@model RealEstatePlatform.Core.Entities.Property

@{
    ViewData["Title"] = Model.Title;
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<div class="container mt-5">
    <div class="mb-3">
        <a href="/Property/Index" class="btn btn-outline-secondary">← Tüm İlanlara Dön</a>
    </div>

    <div class="row">
        <div class="col-md-7 mb-4">
            <div class="card shadow-sm mb-4">
                @if (Model.Images != null && Model.Images.Any())
                {
                    <img src="@Model.Images.FirstOrDefault()?.ImagePath" class="card-img-top img-fluid rounded" alt="@Model.Title" style="max-height: 450px; width: 100%; object-fit: cover;">
                }
                else
                {
                    <img src="https://via.placeholder.com/800x400?text=Gorsel+Yok" class="card-img-top" alt="Görsel Yok">
                }

                <div class="card-body">
                    <h2 class="card-title text-primary">@Model.Title</h2>
                    <h3 class="text-success my-3">@Model.Price.ToString("N0") ₺</h3>

                    <hr />

                    <h5>Açıklama</h5>
                    <p class="card-text text-muted fs-6" style="white-space: pre-line;">@Model.Description</p>
                </div>
            </div>
        </div>

        <div class="col-md-5">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Gayrimenkul Özellikleri</h5>
                </div>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span>🚪 Oda Sayısı</span>
                        <strong>@Model.RoomCount</strong>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span>📐 Metrekare</span>
                        <strong>@Model.SquareMeters m²</strong>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span>🚗 Otopark</span>
                        <strong>@(Model.HasParking ? "Var" : "Yok")</strong>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span>📅 İlan Tarihi</span>
                        <strong>@Model.CreatedDate.ToString("dd.MM.yyyy")</strong>
                    </li>
                </ul>
            </div>

            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0">📍 Konum Bilgisi</h5>
                </div>
                <div class="card-body">
                    @if (Model.Location != null)
                    {
                        <p class="fw-bold mb-2">@Model.Location.City / @Model.Location.District</p>
                        
                        <div id="detailMap" style="height: 250px; width: 100%; border-radius: 8px; border: 1px solid #ccc;"></div>
                    }
                    else
                    {
                        <div class="alert alert-secondary text-center mb-0">Konum bilgisi eklenmemiş.</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@if (Model.Location != null)
{
    @section Scripts {
        <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
        
        <script>
            // İlanın kaydedilmiş koordinatları
            var lat = @Model.Location.Latitude.ToString(System.Globalization.CultureInfo.InvariantCulture);
            var lng = @Model.Location.Longitude.ToString(System.Globalization.CultureInfo.InvariantCulture);

            // Haritayı bu koordinatlar merkezde olacak şekilde başlat
            var map = L.map('detailMap').setView([lat, lng], 14);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '© OpenStreetMap contributors'
            }).addTo(map);

            // Evin konumuna sabit işaretçi (marker) koy ve üzerine baloncuk ekle
            L.marker([lat, lng]).addTo(map)
                .bindPopup("<b>@Model.Title</b><br>@Model.Location.City / @Model.Location.District")
                .openPopup();
        </script>
    }
}